// Prisma Schema for Dayflow HRMS
// Production-grade schema for Foundation, Data Modeling, Auth & RBAC

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
}

enum LeaveType {
  PAID
  SICK
  UNPAID
  CASUAL
  MATERNITY
  PATERNITY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentCycle {
  MONTHLY
  BI_WEEKLY
  WEEKLY
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         String     @default("EMPLOYEE") // Stored as string for SQLite compatibility ("ADMIN" | "HR" | "EMPLOYEE")
  status       String     @default("ACTIVE")   // "ACTIVE" | "INACTIVE" | "SUSPENDED"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relationships
  profile           Profile?
  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]     @relation("UserLeaveRequests")
  approvedLeaves    LeaveRequest[]     @relation("ApproverLeaveRequests")
  salaryStructure   SalaryStructure?
  auditLogs         AuditLog[]         @relation("UserAuditLogs")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Profile {
  id               String    @id @default(cuid())
  userId           String    @unique
  employeeId       String    @unique // e.g. "EMP-001", "ADM-001"
  firstName        String
  lastName         String
  phone            String?
  department       String    // e.g. "Engineering", "Human Resources", "Executive", "Marketing", "Design"
  designation      String    // e.g. "Senior Fullstack Dev", "HR Manager", "CEO"
  joiningDate      DateTime  @default(now())
  avatarUrl        String?
  address          String?
  emergencyContact String?
  dateOfBirth      DateTime?
  gender           String?   // "Male" | "Female" | "Other" | "Prefer not to say"
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([employeeId])
  @@index([department])
  @@index([designation])
  @@map("profiles")
}

model AttendanceRecord {
  id                 String    @id @default(cuid())
  userId             String
  date               DateTime  // Normalized date (e.g. 2026-08-22T00:00:00.000Z)
  checkIn            DateTime?
  checkOut           DateTime?
  status             String    @default("PRESENT") // "PRESENT" | "ABSENT" | "HALF_DAY" | "LATE" | "ON_LEAVE"
  workingHours       Float     @default(0.0)       // Calculated decimal hours e.g. 8.5
  overtimeHours      Float     @default(0.0)       // Overtime hours beyond 8.5 standard shift
  shiftType          String    @default("GENERAL") // "MORNING" | "GENERAL" | "NIGHT" | "FLEXIBLE"
  penaltyApplied     String?   // "NONE" | "LATE_WARNING" | "HALF_DAY_PENALTY"
  latitude           Float?    // Captured browser GPS
  longitude          Float?
  locationName       String?   // e.g. "San Francisco HQ (Verified Geofence)"
  isGeofenceVerified Boolean   @default(false)
  isIpVerified       Boolean   @default(false)
  ipAddress          String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
  @@index([shiftType])
  @@map("attendance_records")
}

model LeaveRequest {
  id              String    @id @default(cuid())
  userId          String
  leaveType       String    // "PAID" | "SICK" | "UNPAID" | "CASUAL" | "MATERNITY" | "PATERNITY"
  startDate       DateTime
  endDate         DateTime
  daysCount       Float     @default(1.0)
  reason          String
  status          String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED"
  approverId      String?
  rejectionReason String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  approver        User?     @relation("ApproverLeaveRequests", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([approverId])
  @@index([status])
  @@index([leaveType])
  @@index([startDate])
  @@map("leave_requests")
}

model SalaryStructure {
  id            String    @id @default(cuid())
  userId        String    @unique
  baseSalary    Float     // Monthly base pay in USD or configured currency
  allowances    Float     @default(0.0) // HRA, Transport, Medical, etc.
  deductions    Float     @default(0.0) // Tax, Insurance, PF
  netSalary     Float     // Computed: baseSalary + allowances - deductions
  currency      String    @default("USD")
  paymentCycle  String    @default("MONTHLY") // "MONTHLY" | "BI_WEEKLY" | "WEEKLY"
  effectiveFrom DateTime  @default(now())
  paymentMethod String    @default("BANK_TRANSFER") // "BANK_TRANSFER" | "CHECK" | "DIRECT_DEPOSIT"
  bankName      String?
  accountNumber String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("salary_structures")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  // Nullable if system action or unauthenticated attempt
  action    String   // e.g. "AUTH_LOGIN", "LEAVE_APPLY", "LEAVE_APPROVE", "SALARY_UPDATE", "USER_REGISTER"
  entity    String   // e.g. "User", "LeaveRequest", "AttendanceRecord", "SalaryStructure"
  entityId  String?  // ID of the target resource
  details   String?  // JSON string or summary of action/payload
  ipAddress String?
  createdAt DateTime @default(now())

  actor     User?    @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
