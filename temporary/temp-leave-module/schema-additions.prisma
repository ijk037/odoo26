enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  ANNUAL_PAID
  SICK
  CASUAL
  MATERNITY_PATERNITY
}

// 1. LeaveBalance Model (Tracks allocated vs remaining leave days per user)
model LeaveBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Quotas
  annualPaidAllocated         Int @default(21)
  annualPaidRemaining         Int @default(21)
  
  sickAllocated               Int @default(10)
  sickRemaining               Int @default(10)
  
  casualAllocated             Int @default(7)
  casualRemaining             Int @default(7)
  
  maternityPaternityAllocated Int @default(90)
  maternityPaternityRemaining Int @default(90)

  updatedAt DateTime @updatedAt
}

// 2. LeaveRequest Model (The core multi-tier approval entity)
model LeaveRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  totalDays Int
  reason    String?  @db.Text
  
  // Multi-Tier Approval System
  managerApprovalStatus ApprovalStatus @default(PENDING)
  hrApprovalStatus      ApprovalStatus @default(PENDING)
  overallStatus         ApprovalStatus @default(PENDING)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  auditLogs AuditLog[]
}

// 3. AuditLog Model (Immutable ledger of all actions)
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  
  action    String   // e.g., "LEAVE_SUBMITTED", "MANAGER_APPROVED", "HR_REJECTED"
  
  entityType String  // e.g., "LeaveRequest"
  entityId   String
  
  metadata  Json     // Stores state changes (e.g., { previousStatus: "PENDING", newStatus: "APPROVED" })
  ipAddress String
  
  leaveRequestId String?
  leaveRequest   LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  
  createdAt DateTime @default(now())
}

